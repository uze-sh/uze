// The plan's title, its open steps, and the one gesture that asks for a
// review.
Stack gap=1 {
    Stack when="title" {
        Text "{title}" strong=#true truncate=#true
        List each="open" empty="Every step is done" {
            Text "{text}" truncate=#true
        }
        Button "Ask for a review" action="review" item="{.}"
    }
    Text "No plan yet" role="faint" unless="title"
}
