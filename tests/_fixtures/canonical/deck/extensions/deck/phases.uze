<script>
// The `phases` source, composed: a row of the milestone's phases, each a
// segment weighted by its plans and filled by how many are summarized.
fn answer(input, context) {
    let phases = [];
    for entry in list_checkout(".planning/phases") {
        if entry.kind == "dir" {
            let plans = 0;
            let done = 0;
            for file in list_checkout(`.planning/phases/${entry.name}`) {
                if file.name.ends_with("-PLAN.md") { plans += 1; }
                if file.name.ends_with("-SUMMARY.md") { done += 1; }
            }
            phases.push(#{ name: entry.name, plans: plans, done: done });
        }
    }
    let segments = [];
    for phase in phases {
        let ratio = if phase.plans == 0 { 0.0 } else { phase.done.to_float() / phase.plans.to_float() };
        segments.push(#{
            type: "Segment",
            props: #{ weight: if phase.plans == 0 { 1 } else { phase.plans }, ratio: ratio,
                      role: if ratio >= 1.0 { "success" } else { "accent" } },
        });
    }
    let label = if input.preferences.detail {
        let names = [];
        for phase in phases { names.push(phase.name); }
        `${phases.len()} phases · ${names}`
    } else {
        `${phases.len()} phases`
    };
    #{ data: #{ type: "Stack", children: [
        #{ type: "Text", args: [label], props: #{ role: "muted" } },
        #{ type: "Progress", children: segments },
    ] } }
}
</script>
