// The sidebar's section: where the runs were asked, and each run's state.
lookup "said" default="unknown" {
    success "passed"
    failure "failed"
    cancelled "cancelled"
    in_progress "running"
    queued "queued"
    none "no runs"
}
lookup "tone" default="muted" {
    success "success"
    failure "danger"
    cancelled "faint"
    in_progress "warning"
    queued "info"
}

Stack {
    Text "{repo} · {branch}" role="faint" truncate=#true
    List each="runs" empty="No runs on this branch" {
        Row gap=1 {
            Text "{said:state}" role="{tone:state}" min-width=9
            Text "{name}" truncate=#true grow=#true
            Text "#{number}" role="faint"
        }
    }
}
