<view>
// The sidebar header's row: the last run's state, in one line.
lookup "said" default="unknown" {
    success "passed"
    failure "failed"
    cancelled "cancelled"
    in_progress "running"
    queued "queued"
    none "no runs"
}
lookup "tone" default="muted" {
    success "success"
    failure "danger"
    in_progress "warning"
    queued "info"
}

Row gap=1 {
    Text "CI" role="secondary"
    Text "{said:last.state}" role="{tone:last.state}"
    Text "{last.name}" role="faint" truncate=#true grow=#true
}
</view>
