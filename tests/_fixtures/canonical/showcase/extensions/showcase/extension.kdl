protocol 1
id "showcase"
name "Showcase"
description "One surface per family of the catalog"

surface "measures" slot="view" view="measures.uze" source="usage" title="Measures"
surface "blocks" slot="view" view="blocks.uze" source="usage" title="Blocks"
surface "structure" slot="drawer" view="structure.uze" source="usage" title="Structure"

source "usage" {
    fixture "fixtures/usage.json"
}
