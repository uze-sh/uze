<view>
// The milestone at a glance, for the sidebar's narrow column.
lookup "tone" default="muted" {
    done "success"
    running "warning"
    ready "info"
    waiting "faint"
}

Stack {
    Row gap=1 {
        Text "{milestone}" strong=#true
        Text "{percent}%" role="muted"
    }
    Progress {
        Segment each="phases" weight="{weight}" ratio="{ratio}" role="{tone:state}"
    }
    Row gap=1 when="current" {
        Text "{current.number}" role="warning"
        Text "{current.name}" truncate=#true grow=#true
        Text "{current.done}/{current.total}" role="muted"
    }
}
</view>
