<view>
// The pet, its name and its mood, and the button that feeds it.
Row gap=1 {
    Sprite "pet" state="{mood}" height=2
    Stack grow=#true {
        Text "{name}" strong=#true
        Text "{said}" role="muted"
    }
    Button "Feed" action="feed"
}
</view>

<script>
// The `kennel` source: the pet's name, kept in the store, and its mood,
// content for ten minutes after it was fed and hungry after.
fn answer(input, context) {
    let content_for = 600000;
    let kept = store();
    let name = kept.name ?? "Pixel";
    let fed = kept.fed ?? 0;
    let content = fed > 0 && clock() - (kept.last_fed ?? 0) < content_for;
    #{
        data: #{
            name: name,
            fed: fed,
            mood: if content { "content" } else { "hungry" },
            said: if content { `content, fed ${fed} times` } else { "hungry" },
        },
        store: #{ name: name },
    }
}

// The `feed` action, called from the kennel: one more meal, and when,
// kept in the store; the kennel is asked again to show the pet content.
fn feed(input, context) {
    let kept = store();
    #{
        data: (),
        store: #{ fed: (kept.fed ?? 0) + 1, last_fed: clock() },
        refresh: ["kennel"],
    }
}
</script>
