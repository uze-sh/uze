test "the bar says today's commits and the last two weeks" {
    surface "today"
    given "git" fixture="fixtures/git.json"
    expect-text "9 today"
    snapshot "bar"
}

test "the heatmap shows 12 weeks, the totals, the chosen day and the authors" {
    surface "heatmap"
    given "git" fixture="fixtures/git.json"
    size 100 40
    expect-text "commits in 12 weeks"
    expect-text "2026-10-27"
    expect-text "who"
    snapshot "heatmap"
}
