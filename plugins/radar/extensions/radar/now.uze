<view>
// One line in the bar, the most pressing state first: an agent waiting on
// you, then the ones working and the longest turn, then how long they have
// all been idle.
Row gap=1 {
    Row gap=1 when="asking" {
        Icon "bell" role="warning"
        Text "{asked} awaiting approval" role="warning"
    }
    Row gap=1 when="busy" {
        Activity busy="{since}"
        Text "{working} working"
        Elapsed since="{since}" role="muted"
    }
    Row gap=1 when="idle" {
        Icon "check" role="faint"
        Text "idle" role="muted"
        Elapsed since="{last}" role="faint" when="last"
    }
}
</view>

<script>
// The agents' state, kept in the store from their events: `working` maps an
// agent to when its turn began, `asking` holds the agents waiting on an
// approval, `last` is when a turn last ended.

// The earliest of a map's values, or ().
fn earliest(times) {
    let first = ();
    for at in times.values() {
        if first == () || at < first { first = at; }
    }
    first
}

fn answer(input, context) {
    let kept = store();
    let working = kept.working ?? #{};
    let asking = kept.asking ?? #{};
    let last = kept.last ?? ();
    let reply = #{};

    if "event" in input {
        let event = input.event;
        let agent = event.agent;
        let prefs = input.preferences;
        if event.name == "agent.turn.started" {
            if !(agent in working) { working[agent] = event.at; }
        } else if event.name == "agent.turn.finished" {
            working.remove(agent);
            asking.remove(agent);
            last = event.at;
            if prefs.sound { reply.sound = "done"; }
        } else if event.name == "agent.approval.asked" {
            asking[agent] = event.harness;
            if prefs.approval {
                reply.notify = #{ title: "Approval", body: `An agent in ${event.harness} asks for approval` };
                reply.sound = "attention";
            }
        } else if event.name == "agent.approval.resolved" {
            asking.remove(agent);
        }
        reply.store = #{ working: working, asking: asking, last: last };
    }

    let asked = asking.len();
    let count = working.len();
    reply.data = #{
        asking: asked > 0,
        asked: asked,
        busy: asked == 0 && count > 0,
        working: count,
        since: earliest(working),
        idle: asked == 0 && count == 0,
        last: last,
    };
    reply
}
</script>
