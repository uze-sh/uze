<view>
// Draws nothing: what radar says arrives as a sound, and an approval as a
// notification the sidebar shows where it shows a new release. The status
// row stands only so its source is asked on every event; an answer that
// draws nothing takes no row.
Row {}
</view>

<script>
// Asked once per event: answers the sound or the notification, as the
// preferences say.
fn answer(input, context) {
    if !("event" in input) {
        return #{ data: #{} };
    }
    let event = input.event;
    let prefs = input.preferences;
    if event.name == "agent.approval.asked" {
        let reply = #{ data: #{} };
        if prefs.approval {
            reply.notify = #{ title: "Approval", body: `An agent in ${event.harness} asks for approval` };
            reply.sound = "attention";
        }
        reply
    } else {
        let reply = #{ data: #{} };
        if prefs.sound { reply.sound = "done"; }
        reply
    }
}
</script>
