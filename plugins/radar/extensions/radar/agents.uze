<view>
// Every agent on a line: the spinner while it works, what it works on,
// and how long the turn has run; stopped, its state.
lookup "tone" default="muted" {
    working "warning"
    done "success"
    ready "info"
}
lookup "state" default="" {
    working "working"
    done "done"
    ready "ready"
}

List each="." empty="no agent open" {
    Row gap=1 {
        Activity busy="{since}"
        Text "{label}" truncate=#true grow=#true
        Elapsed since="{since}" role="warning" when="since"
        Text "{state:state}" role="{tone:state}" unless="since"
    }
}
</view>
