// Radar: what the workspace's agents are doing, in one item of the bar:
// one asking for approval, the ones working and for how long, or how long
// they have been idle. A click opens the drawer of what they did, tool by
// tool. A finished turn plays a sound, and an agent asking for approval
// notifies, as the operator prefers.
//
// It lists no agent: the sidebar already does. What it adds is the state
// of all of them at a glance, from anywhere, and what they touched.
protocol 1
id "radar"
name "Radar"
description "The agents at a glance, and what they did"

wants "agent:observe" "notify" "store"

preferences {
    toggle "sound" label="Play a sound when a turn ends" default=#true
    toggle "approval" label="Notify when an agent asks for approval" default=#true
}

// In the bar, on the right: the state of every agent in one line; a click opens the
// drawer.
surface "now" slot="bar" align="right" view="now.uze" source="watch" opens="events"

// What the agents did, newest first: each tool and the file it touched.
surface "events" slot="drawer" view="events.uze" source="events" title="Agent events"

source "events" { events 40; }

// Asked once per event: keeps which agents are working and which ask for
// approval in the store, and answers the sound and the notification.
source "watch" {
    script "now.uze"
    deliver "each"
    preferences
    refresh-on "agent.turn.started"
    refresh-on "agent.turn.finished"
    refresh-on "agent.approval.asked"
    refresh-on "agent.approval.resolved"
    // No harness says an approval was answered: the agent doing anything
    // after it is the answer, and a new session starts with none pending.
    refresh-on "agent.tool.finished"
    refresh-on "agent.session.started"
}
