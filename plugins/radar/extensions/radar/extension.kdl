// Radar: what the workspace's agents are doing. A section lists every agent
// and how long its turn has run, and opens the last events over
// everything. A finished turn plays a sound, and an agent asking for approval
// notifies, as the operator prefers: the sidebar shows that notice where it
// shows a new release.
protocol 1
id "radar"
name "Radar"
description "Who is working, for how long, and what just happened"

wants "agent:observe" "notify"

preferences {
    toggle "sound" label="Play a sound when a turn ends" default=#true
    toggle "approval" label="Notify when an agent asks for approval" default=#true
}

// Draws nothing: a source is asked only while a surface shows it, and a
// status row that answers nothing takes no room.
surface "notice" slot="status" view="notice.uze" source="notice" title="Radar"

// Every agent: working and for how long, or how it stopped.
surface "agents" slot="section" view="agents.uze" source="crew" title="Agents"

// The last events, over everything, opened from the section. No key is
// suggested: every alt chord was someone's (the host's files on alt+e,
// NVIDIA's overlay on alt+r, an image paste on alt+v); the person binds one
// on the Keys screen if they want it.
surface "events" slot="overlay" view="events.uze" source="events" title="Agent events"

source "crew" { agents; }

source "events" { events 40; }

// Asked once per event: the sound, the notification, and what the line at
// the top says.
source "notice" {
    script "notice.uze"
    deliver "each"
    preferences
    refresh-on "agent.turn.finished"
    refresh-on "agent.approval.asked"
}

action "events" label="Agent events" on="agents" {
    open "events"
}
