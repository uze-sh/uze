<view>
// The drawer, read while the agent works: the milestone and how far it
// is, what waits for the person, and the phases, the one in front opened
// to its goal, its steps and its plans wave by wave, with the one button
// that asks for its next step. Every row of a phase keeps the columns of
// the one above it: mark, number, name, count.
lookup "fill" default="faint" {
    done "success"
    current "warning"
}

lookup "step" default="faint" {
    done "success"
    current "warning"
}

lookup "plan" default="faint" {
    done "secondary"
    waiting "danger"
}

Stack gap=1 {
    Stack {
        Row gap=1 {
            Text "{version}" strong=#true
            Text "{name}" role="secondary" truncate=#true grow=#true
            Text "{percent}%" role="secondary"
        }
        Progress style="line" {
            Segment each="segments" weight="{weight}" ratio="{ratio}" role="{fill:state}"
        }
        Text "{done} of {total} phases · {next}" role="muted"
    }

    // A plan stopped for the person, said once, at the top: the band over
    // the agent is where it is answered.
    Row gap=2 when="checkpoint" {
        Icon "checkpoint" role="danger"
        Text "{checkpoint.plan} needs you" role="danger" strong=#true
        Text "{checkpoint.title}" role="secondary" truncate=#true grow=#true
    }

    Stack {
        Stack each="phases" {
            Row gap=2 when="finished" {
                Icon "check" role="success"
                Text "{number}" role="muted" min-width=2
                Text "{name}" role="muted" truncate=#true grow=#true
                Text "{plans}" role="muted"
            }

            // The phase in front: its goal, its steps, its plans wave by
            // wave, and the button for its next step.
            Stack when="front" {
                Row gap=2 {
                    Text "▶" role="warning"
                    Text "{number}" role="bright" strong=#true min-width=2
                    Text "{name}" role="bright" strong=#true truncate=#true grow=#true
                    Text "{front.ran}/{front.plans}" role="secondary" when="front.plans"
                }
                Row when="front.goal" {
                    Text "" min-width=7
                    Text "{front.goal}" role="muted" truncate=#true grow=#true
                }
                Row {
                    Text "" min-width=7
                    // Wrapped rather than cut on a narrow drawer.
                    // The air between steps is each step's own: a wrapping
                    // box spaces its rows as much as its columns.
                    Box direction="row" wrap=#true grow=#true {
                        Row gap=1 each="front.steps" {
                            Icon "check" role="success" when="done"
                            Text "{mark}" role="{step:state}" unless="done"
                            Text "{name}" role="{step:state}"
                            Text "" min-width=0
                        }
                    }
                }
                Text "" when="front.listed"
                Row gap=2 each="front.listed" {
                    Text "" min-width=5
                    Text "{lead}" role="faint" min-width=6
                    Row gap=1 {
                        Icon "check" role="success" when="done"
                        Icon "checkpoint" role="danger" when="waiting"
                        Text "○" role="faint" when="pending"
                        Text "{id}" role="muted" min-width=4
                    }
                    Text "{title}" role="{plan:state}" truncate=#true grow=#true
                }
                Text "" unless="front.waiting"
                Row align="end" unless="front.waiting" {
                    Button "{front.label}" action="next" item="{front}"
                }
                Text ""
            }

            Row gap=2 when="ahead" {
                Text "·" role="faint"
                Text "{number}" role="faint" min-width=2
                Text "{name}" role="faint" truncate=#true grow=#true
                Text "{after}" role="faint"
            }
        }
    }
}
</view>
