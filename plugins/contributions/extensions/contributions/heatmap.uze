<view>
// A strip along the bottom of the agent area: the totals over the map,
// and beside it the chosen day's commits and who wrote them. A click on a
// day chooses it.
Stack gap=1 {
    Row gap=4 {
        Stat "{total}" "commits in 12 weeks" role="success"
        Stat "{active}" "days with a commit" role="info"
        Stat "{best}" "on the busiest day" role="warning"
    }

    Row gap=4 {
        Stack gap=1 {
            Cells rows="{grid}" regions="{regions}"
            Row gap=1 {
                Text "less" role="faint"
                Marks {
                    Mark role="faint"
                    Mark role="info"
                    Mark role="success"
                    Mark role="warning"
                }
                Text "more" role="faint"
            }
        }

        Stack gap=1 grow=#true {
            Rule "{chosen.date}" when="chosen"
            Rule "click a day to see its commits" unless="chosen"
            List each="chosen.commits" empty="no commit that day" when="chosen" {
                Row gap=2 {
                    Text "{hash}" role="info" min-width=7
                    Text "{subject}" truncate=#true grow=#true
                    Text "{author}" role="muted"
                }
            }
        }

        Stack gap=1 min-width=22 {
            Rule "who"
            Table "author" "commits" {
                Row each="authors" {
                    Text "{name}"
                    Text "{count}" role="muted"
                }
            }
        }
    }
}
</view>

<script>
// The last 12 weeks of git log as a heatmap, from one `git log`. The
// chosen day is kept in the store, and its commits come from the same log.

// Days since 1970 of "YYYY-MM-DD" (Howard Hinnant).
fn days_of(iso) {
    let y = iso.sub_string(0, 4).parse_int();
    let m = iso.sub_string(5, 2).parse_int();
    let d = iso.sub_string(8, 2).parse_int();
    let y = if m <= 2 { y - 1 } else { y };
    let era = (if y >= 0 { y } else { y - 399 }) / 400;
    let yoe = y - era * 400;
    let mp = (m + 9) % 12;
    let doy = (153 * mp + 2) / 5 + d - 1;
    era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
}

// "YYYY-MM-DD" of days since 1970.
fn iso_of(days) {
    let z = days + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = if m <= 2 { yoe + era * 400 + 1 } else { yoe + era * 400 };
    let two = |n| if n < 10 { `0${n}` } else { `${n}` };
    `${y}-${two.call(m)}-${two.call(d)}`
}

// A day's tone, by where it stands among the days that had a commit: up
// to the median, up to the 85th percentile, above. One exceptional day
// does not wash out the others, and the map reads the same for a
// repository of a commit a week and one of a hundred a day.
fn tone_of(count, cuts) {
    if count == 0 { "faint" } else if count <= cuts[0] { "info" } else if count <= cuts[1] { "success" } else { "warning" }
}

fn answer(input, context) {
    let today = clock() / 86400000;
    // The week starts on Monday: today is row `(today + 3) % 7`.
    let weekday = (today + 3) % 7;
    let weeks = 12;
    let first = today - weekday - (weeks - 1) * 7;

    let log = run_program("git", ["log", `--since=${iso_of(first)}`, "--format=%ad%x09%an%x09%h%x09%s", "--date=short"]);
    if log.code != 0 {
        return #{ data: #{ error: `git log failed: ${log.stderr}` } };
    }
    // A commit per line; the chosen day's are kept as they come, by the
    // same date the map counts.
    let picked = store().day ?? ();
    let per_day = #{};
    let per_author = #{};
    let commits = [];
    for line in lines(log.stdout) {
        let parts = line.split("\t");
        if parts.len() < 4 { continue; }
        per_day[parts[0]] = (per_day[parts[0]] ?? 0) + 1;
        per_author[parts[1]] = (per_author[parts[1]] ?? 0) + 1;
        if parts[0] == picked {
            commits.push(#{ hash: parts[2], subject: parts[3], author: parts[1] });
        }
    }
    let counts = per_day.values();
    counts.sort();
    let best = if counts.len() > 0 { counts[counts.len() - 1] } else { 0 };
    let cuts = if counts.len() > 0 { [counts[counts.len() / 2], counts[counts.len() * 85 / 100]] } else { [0, 0] };

    // The map's rows: the weekday's letter and a square per week.
    let letters = ["M", "T", "W", "T", "F", "S", "S"];
    let grid = [];
    let regions = [];
    for row in 0..7 {
        let cells = [#{ ch: letters[row], role: "faint" }, #{ ch: " ", role: "faint" }];
        for week in 0..weeks {
            let day = first + week * 7 + row;
            if day > today {
                cells.push(#{ ch: " ", role: "faint" });
            } else {
                let iso = iso_of(day);
                let count = per_day[iso] ?? 0;
                cells.push(#{ ch: "■", role: tone_of(count, cuts) });
                regions.push(#{ x: 2 + week * 2, y: row, w: 1, h: 1, action: "day", item: #{ date: iso } });
            }
            cells.push(#{ ch: " ", role: "faint" });
        }
        grid.push(cells);
    }

    let recent = [];
    for back in range(13, -1, -1) {
        recent.push(per_day[iso_of(today - back)] ?? 0);
    }
    let authors = [];
    for name in per_author.keys() {
        authors.push(#{ name: name, count: per_author[name] });
    }
    authors.sort(|a, b| b.count - a.count);
    let total = 0;
    for n in per_day.values() { total += n; }

    let chosen = if picked != () { #{ date: picked, commits: commits } } else { () };

    #{
        data: #{
            today: per_day[iso_of(today)] ?? 0,
            recent: recent,
            total: total,
            active: per_day.len(),
            best: best,
            grid: grid,
            regions: regions,
            authors: authors,
            chosen: chosen,
        }
    }
}

// A click on a day: it is chosen, and the map is asked again.
fn choose(input, context) {
    #{ data: (), store: #{ day: input.item.date }, refresh: ["git"] }
}
</script>
