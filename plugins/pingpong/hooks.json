{
  "hooks": {
    "SessionStart": [
      {
        "id": "session-start",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hook",
            "args": ["log"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "id": "deny-ping",
        "matcher": "shell",
        "effect": "deny",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hook",
            "args": ["deny"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "id": "after-shell",
        "matcher": "shell",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hook",
            "args": ["log"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "stop",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hook",
            "args": ["log"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
