<view>
// A card's ground: the goal met in the worklog's tone, partly met in a
// grey; a day with nothing logged, no ground.
lookup "ground" default="" {
    full "info"
    partial "secondary"
}

// A day with nothing logged is quiet; on a card, the host picks the ink.
lookup "ink" default="default" {
    empty "muted"
}

lookup "tone" default="faint" {
    full "info"
    partial "secondary"
    empty "faint"
    pad "faint"
}

Stack gap=1 {
    // The month's goal.
    Stack {
        Text "GOAL {target_per_day}H PER WORKING DAY" role="faint" strong=#true
        Row gap=1 {
            Text "{total}" role="info" strong=#true
            Text "logged of {target} expected" strong=#true grow=#true
        }
        Text "{pct} of the goal · {gap_days} · {touched}" role="muted"
        Progress ratio="{ratio}" role="info" style="line"
    }

    // The month, and what can be done with it.
    Row gap=1 {
        Button "‹" action="prev"
        Text "{month}" strong=#true
        Button "›" action="next"
        Text "" grow=#true
        Button "refresh" action="refresh"
    }

    Tabs id="view" {
        Tab "Month" value="month"
        Tab "Week" value="week"
    }

    // Month: a card per working day, five to a row, filled in the colour of how much was logged.
    Stack gap=1 show="ui.view=month" {
        Box direction="row" gap=1 {
            Text "MON" role="faint" min-width=0 grow=#true
            Text "TUE" role="faint" grow=#true
            Text "WED" role="faint" grow=#true
            Text "THU" role="faint" grow=#true
            Text "FRI" role="faint" grow=#true
        }
        Box direction="row" wrap=#true gap=1 {
            Box each="days" width="19%" height=3 padding-x=1 ground="{ground:state}" {
                Row when="day" {
                    Text "{day}" role="{ink:state}" strong=#true grow=#true
                    Text "{hours}" role="{ink:state}" strong=#true
                }
                Text "{items}" truncate=#true when="filled"
                Text "" unless="filled"
                Stack unless="filled" {
                    Progress ratio=0 style="line" when="day"
                }
            }
        }
    }

    // Week: the week of the latest working day, with what went into each day.
    List each="lastweek" show="ui.view=week" {
        Stack {
            Row gap=2 {
                Text "{label}" strong=#true min-width=7
                Progress ratio="{ratio}" role="{tone:state}" style="line" grow=#true
                Text "{hours}" strong=#true
            }
            List each="items" {
                Row gap=2 {
                    Text "" min-width=7
                    Text "{hours}" role="muted" min-width=4
                    Text "{title}" role="muted" truncate=#true grow=#true
                }
            }
        }
    }

    Rule "where the hours went"
    List each="items" empty="nothing logged yet this month" {
        Stack {
            Row gap=1 {
                Text "{id}" role="info"
                Text "{title}" truncate=#true grow=#true
                Text "{hours}" strong=#true
            }
            Progress ratio="{ratio}" role="info" style="line"
        }
    }

    Rule "{unlogged_label}" when="unlogged"
    List each="unlogged" when="unlogged" {
        Row gap=1 {
            Text "{id}" role="info"
            Text "{title}" role="muted" truncate=#true grow=#true
        }
    }

    Text "{updated}" role="faint"
}
</view>

<script>
// A month of the worklog, summed the way the panel draws it. The entries
// come from the `worklog_month` tool of the `worklog` MCP server, the one
// the agents call too; the month is the current one plus `offset` months,
// which the ‹ › buttons keep in the store.

// Days since 1970-01-01 of a civil date (Howard Hinnant).
fn days_from_civil(y, m, d) {
    let y = if m <= 2 { y - 1 } else { y };
    let era = (if y >= 0 { y } else { y - 399 }) / 400;
    let yoe = y - era * 400;
    let mp = (m + 9) % 12;
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// [year, month, day] of days since 1970-01-01.
fn civil_from_days(days) {
    let z = days + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    [if m <= 2 { yoe + era * 400 + 1 } else { yoe + era * 400 }, m, d]
}

// Days since 1970 of "YYYY-MM-DD".
fn days_of(iso) {
    days_from_civil(iso.sub_string(0, 4).parse_int(), iso.sub_string(5, 2).parse_int(), iso.sub_string(8, 2).parse_int())
}

// 0 = Monday.
fn dow(days) {
    (days % 7 + 3) % 7
}

fn two(n) {
    if n < 10 { `0${n}` } else { `${n}` }
}

fn iso_of(days) {
    let c = civil_from_days(days);
    `${c[0]}-${two(c[1])}-${two(c[2])}`
}

// "8h", "7.5h": up to two places, no idle zeros.
fn hrs(n) {
    let rounded = (n.to_float() * 100.0).round() / 100.0;
    if rounded == rounded.floor() { `${rounded.to_int()}h` } else { `${rounded}h` }
}

fn state_of(hours, target) {
    if hours >= target { "full" } else if hours > 0 { "partial" } else { "empty" }
}

fn plural(n, one, many) {
    if n == 1 { `${n} ${one}` } else { `${n} ${many}` }
}

fn answer(input, context) {
    let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let DOW = ["mon", "tue", "wed", "thu", "fri"];
    let kept = store();
    let offset = kept.offset ?? 0;
    let today = civil_from_days(clock() / 86400000);
    let total_months = today[0] * 12 + (today[1] - 1) + offset;
    let year = total_months / 12;
    let number = total_months % 12 + 1;
    let month = `${year}-${two(number)}`;

    let ts = mcp("worklog", "worklog_month", #{ month: month });

    let days = ts.days;
    days.sort(|a, b| if a.date < b.date { -1 } else if a.date > b.date { 1 } else { 0 });
    let weekdays = days.filter(|d| !d.isWeekend);
    let target_per_day = ts.targetHours;

    let total = 0.0;
    for d in days { total += d.hours.to_float(); }
    let target = weekdays.len() * target_per_day;
    let gap_days = weekdays.filter(|d| d.hours < d.target).len();
    let pct = if target > 0 { (total / target.to_float() * 100.0).round().to_int() } else { 0 };

    let by_item = #{};
    let order = [];
    for d in days {
        for it in d.items {
            if it.id in by_item {
                by_item[it.id].hours += it.hours.to_float();
            } else {
                by_item[it.id] = #{ id: it.id, title: it.title, hours: it.hours.to_float(), url: it.url };
                order.push(it.id);
            }
        }
    }
    let items = order.map(|id| by_item[id]);
    items.sort(|a, b| if a.hours > b.hours { -1 } else if a.hours < b.hours { 1 } else { 0 });
    let max_item = 1.0;
    for it in items { if it.hours > max_item { max_item = it.hours; } }

    // Month: a card per working day, the first week pushed to its weekday.
    let cards = [];
    if weekdays.len() > 0 {
        for pad in 0..dow(days_of(weekdays[0].date)) { cards.push(#{ pad: true }); }
    }
    for d in weekdays {
        let n = d.items.len();
        let state = state_of(d.hours, d.target);
        cards.push(#{
            day: `${d.date.sub_string(8, 2).parse_int()}`,
            hours: hrs(d.hours),
            items: if n > 0 { plural(n, "item", "items") } else { "" },
            state: state,
            filled: state != "empty",
        });
    }
    while cards.len() % 5 != 0 { cards.push(#{ pad: true }); }

    // Week: Monday to Friday, the week of the latest working day.
    let lastweek = [];
    if weekdays.len() > 0 {
        let last = days_of(weekdays[weekdays.len() - 1].date);
        let monday = last - dow(last);
        for i in 0..5 {
            let iso = iso_of(monday + i);
            let found = weekdays.filter(|d| d.date == iso);
            let d = if found.len() > 0 { found[0] } else { #{ date: iso, hours: 0, target: target_per_day, items: [] } };
            lastweek.push(#{
                label: `${DOW[i]} ${iso.sub_string(8, 2).parse_int()}`,
                hours: hrs(d.hours),
                ratio: (d.hours.to_float() / d.target.to_float()).min(1.0),
                state: state_of(d.hours, d.target),
                items: d.items.map(|it| #{ hours: hrs(it.hours), title: it.title }),
            });
        }
    }

    let unlogged = ts.unloggedItems.map(|it| #{ id: it.id, title: it.title, url: it.url });
    let generated = ts.generatedAt;

    #{
        data: #{
            month: `${MONTHS[number - 1]} ${year}`,
            target_per_day: target_per_day,
            total: hrs(total),
            target: hrs(target),
            pct: `${pct}%`,
            ratio: if target > 0 { (total / target.to_float() * 1000.0).round() / 1000.0 } else { 0.0 },
            gap_days: `${plural(gap_days, "working day", "working days")} under the goal`,
            touched: plural(items.len(), "item touched", "items touched"),
            days: cards,
            lastweek: lastweek,
            items: items.map(|it| #{ id: it.id, title: it.title, hours: hrs(it.hours), ratio: it.hours / max_item, url: it.url }),
            unlogged: unlogged,
            unlogged_label: `assigned, nothing logged (${unlogged.len()})`,
            updated: `updated ${generated.sub_string(0, 10)} ${generated.sub_string(11, 5)} · ${ts.user}`,
        }
    }
}

// ‹ and ›: the current month plus the offset the store keeps; a month to
// come has no entries, so › stops at the current one.
fn prev(input, context) {
    let offset = store().offset ?? 0;
    #{ data: (), store: #{ offset: offset - 1 }, refresh: ["sheet"] }
}

fn next(input, context) {
    let offset = store().offset ?? 0;
    #{ data: (), store: #{ offset: if offset < 0 { offset + 1 } else { 0 } }, refresh: ["sheet"] }
}
</script>
