// Milestone: the checkout's .planning/ (a milestone in phases) beside the
// agent. One way in and one place: the bar says how far it has come and
// opens the drawer; the drawer holds the next step, with its button, the
// roadmap and the phase's plan.
protocol 1
id "milestone"
name "Milestone"
description "The milestone in .planning/: progress in the bar, the next step and the roadmap in a drawer"

wants "read:checkout" "agent:prompt"

// In the bar: how many phases are done and which is next; a click opens
// the drawer.
surface "progress" slot="bar" view="bar.uze" source="plan" opens="roadmap" applies-when=".planning"

// The drawer: the next step, the roadmap and the phase's plan.
surface "roadmap" slot="drawer" view="roadmap.uze" source="plan" title="Milestone" applies-when=".planning"

// The milestone read from .planning/, again whenever a file there changes.
source "plan" {
    script "roadmap.uze"
    applies-when ".planning/STATE.md"
    refresh-on "paths.changed" ".planning"
}

// The next step, the only one the extension offers: plan the phase that
// has no plan, execute the one that has.
action "plan" label="Plan the phase" on="roadmap" {
    agent-prompt skill="milestone:plan-phase" "{number}" target="self"
}

action "execute" label="Execute the phase" on="roadmap" {
    agent-prompt skill="milestone:execute-phase" "{number}" target="self"
}
