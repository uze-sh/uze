test "the bar says how many phases are done and which is next" {
    surface "progress"
    given "plan" fixture="fixtures/plan.json"
    expect-text "1/4"
    expect-text "phase 2"
    snapshot "bar"
}

test "the drawer offers the next step at the top, and only it" {
    surface "roadmap"
    given "plan" fixture="fixtures/plan.json"
    expect-text "v1 · a tasks CLI"
    expect-text "phase 2 · Keep tasks in a file"
    press-button "execute"
    expect-action "execute" number="2"
}

test "the drawer opens on the roadmap, a row per phase" {
    surface "roadmap"
    given "plan" fixture="fixtures/plan.json"
    expect-text "CLI skeleton"
    expect-text "Mark a task done"
    expect-no-text "store.py"
    snapshot "roadmap"
}

test "the phase's plan is the markdown the agent wrote" {
    surface "roadmap"
    given "plan" fixture="fixtures/plan.json"
    click "phase plan"
    expect-text "Phase 2 · Keep tasks in a file"
    expect-text "store.py"
    snapshot "plan"
}
