---
title: Crate layering
---
flowchart TD
  subgraph presentation [Presentation · src/]
    cli[CLI<br/>main.rs · clap]
    tui[Workspace TUI<br/>src/ui · ratatui]
    shim[Runtime shim<br/>src/shim.rs · the workspace's]
  end
  ext[uze-extensions<br/>describes, never draws]
  keys[uze-keys<br/>actions · scopes]
  theme[uze-theme<br/>tokens · symbols]
  terminal[uze-terminal<br/>PTY server + protocol]
  app[uze-application<br/>UzeApplication facade]
  subgraph ws [uze-workspace · the workspace's domain]
    tasks[task · checkout · worktree<br/>where an agent works]
    landing[landing<br/>how its work reaches the target]
    conversation[conversation · continuity<br/>what a launch carries over]
    declaration[declaration<br/>agents.yaml's worktrees · artifacts]
  end
  subgraph core [uze-core · shared foundation + package manager]
    package[package<br/>acquisition · trust · store]
    capability[capability<br/>skill · agent · hook · harness block]
    delivery[delivery<br/>router · engine · receipts · replace_dir]
    project[project<br/>manifest · lock · context · anchor]
    machine[machine<br/>home · subprocess · PATH]
  end
  subgraph integrations [uze-integrations]
    registry[registry<br/>composition root]
    verticals[harness verticals<br/>one module per harness]
    shared[shared<br/>dialect · tree mirror · process · path]
  end
  git[uze-git<br/>the one Git transport]
  document[uze-document<br/>the shape a record declares]
  store[(Store · ~/.uze)]

  cli --> app
  tui --> app
  tui --> ext
  cli --> ext
  tui --> keys
  tui --> terminal
  cli --> theme
  tui --> theme
  shim -.->|sanctioned| machine
  app --> package
  app --> delivery
  app --> project
  app --> registry
  app --> tasks
  tasks --> project
  tasks --> git
  landing --> git
  declaration --> project
  conversation --> delivery
  shim -.->|sanctioned| conversation
  registry --> verticals
  verticals --> shared
  verticals -.->|IntegrationPort| delivery
  delivery --> capability
  delivery --> machine
  package --> git
  project --> git
  package --> store
  delivery --> document
  terminal --> document
