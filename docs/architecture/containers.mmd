---
title: Container diagram for uze
---
C4Container
  Person(dev, "Developer", "Installs plugins once, then runs coding agents side by side and reviews their work")
  System_Ext(harness, "Coding-agent harnesses", "Claude Code, Codex, OpenCode and Antigravity CLI: run the coding agents, which call back into uze")
  System_Ext(market, "Marketplaces", "Git repositories holding a marketplace.json and the plugins it lists")
  SystemDb_Ext(repo, "Project repository", "The project's Git repository and its remote: agents.yaml, agents.lock, AGENTS.md and each agent's branch")
  System_Ext(releases, "GitHub Releases", "One archive of uze per platform, and the signed SHASUMS256.txt that authenticates them")
  System_Boundary(uze, "uze") {
    Container(cli, "uze CLI", "Rust, clap, ratatui", "Every command, the workspace client among them: installs and delivers plugins, places agents in checkouts, lands their work")
    Container(terminal, "Terminal server", "Rust, portable-pty", "uze terminal serve, detached, one per UZE_HOME: owns every pane's pseudoterminal, so a pane outlives its client", $link="crates/uze-terminal/src/lib.rs")
    Container(shim, "Runtime shim", "Rust", "The uze binary invoked under a harness's name: adds the projected context and conversation to a launch, then becomes the real harness", $link="src/shim.rs")
    Container(confine, "Confinement helper", "Rust, Landlock, seccomp, Seatbelt", "uze __confine: confines itself, then becomes an extension's pinned program", $link="src/cli/confine.rs")
    ContainerDb(store, "Store", "Filesystem", "UZE_HOME/store: installed package bytes; no harness reads them", $link="crates/uze-core/src/machine/home.rs")
    ContainerDb(state, "Records", "Filesystem, JSON", "UZE_HOME/state: receipts, consents, each project's agents and conversations, the terminal's open spaces", $link="crates/uze-core/src/machine/home.rs")
    ContainerDb(runtime, "Generated tier", "Filesystem, JSON, JSONL", "UZE_HOME/runtime: plugins and mirrors harnesses read, rebuilt from the Store; each agent's report journal", $link="crates/uze-core/src/machine/home.rs")
  }
  Rel(dev, cli, "Runs commands and works in the workspace client of", "Terminal")
  Rel(dev, harness, "Converses with coding agents in", "Terminal pane")
  Rel(cli, terminal, "Starts, attaches to and stops", "Unix domain socket or named pipe, versioned protocol")
  Rel(terminal, shim, "Starts each pane's harness through", "PTY spawn, shims first on PATH")
  Rel(terminal, harness, "Hosts each harness and types allowed prompts into", "PTY")
  Rel(terminal, state, "Persists the open spaces and panes in", "Filesystem, JSON")
  Rel(shim, harness, "Becomes the real binary of, with the projected context", "exec")
  Rel(shim, state, "Reads and records each agent's conversation in", "Filesystem, JSON")
  Rel(harness, cli, "Reports turns and names and delivers its work through", "exec, uze agent")
  Rel(harness, runtime, "Reads delivered plugins and mirrors from", "Filesystem")
  Rel(harness, repo, "Commits each agent's work on its own branch in", "Git")
  Rel(cli, harness, "Writes plugins, hooks, rules and context into the configuration of", "Filesystem")
  Rel(cli, confine, "Runs a consented extension's program through", "Process spawn, JSON on stdin and stdout")
  Rel(cli, store, "Acquires package bytes into", "Filesystem")
  Rel(cli, state, "Records receipts, consents and agents in", "Filesystem, JSON")
  Rel(cli, runtime, "Materializes plugins and mirrors into, and appends agents' reports to", "Filesystem, JSONL")
  Rel(cli, market, "Clones and fetches marketplaces from", "Git over HTTPS or SSH")
  Rel(cli, repo, "Reads declarations from, keeps checkouts in, and pushes finished work to", "Git, files")
  Rel(cli, releases, "Downloads and verifies its own updates from", "HTTPS, SHA-256, signed SHASUMS256.txt")
