{
  "version": 1,
  "name": "uze ascii",
  "description": "UZE's colours with every glyph inside ASCII, for a terminal with no Unicode font. Declares symbols only — every colour comes from the built-in default, which is what a partial theme is for.",
  "glyphs": "ascii",
  "symbols": {
    "mark.native": "+",
    "mark.official": "*",
    "mark.ok": "v",
    "mark.adapted": "~",
    "mark.unsupported": "-",
    "mark.attention": "!",
    "mark.close": "x",
    "mark.failed": "x",
    "mark.done": "v",
    "mark.dot": "-",
    "mark.unsaved": "*",
    "mark.more": "...",
    "mark.cross": "x",
    "mark.sparkle": "+",
    "mark.toggle-off": "o",
    "mark.toggle-on": "@",
    "mark.standing": "*",

    "file.directory": "",
    "file.directory-open": "",
    "file.default": "",
    "file.code": "",
    "file.markup": "",
    "file.config": "",
    "file.lock": "",
    "file.data": "",
    "file.image": "",
    "file.archive": "",
    "file.git": "",
    "file.legal": "",

    "task.ready": "^",
    "task.review": "@",

    "status.working": ["|", "/", "-", "\\"],
    "status.completed": "*",
    "status.selected": "@",
    "status.idle": ".",
    "status.running": ">",

    "progress.fill": ["#"],
    "progress.track": "-",
    "progress.line": "=",
    "icon.clock": "t",
    "icon.timer": "%",
    "icon.calendar": "D",
    "icon.check": "v",
    "icon.cross": "x",
    "icon.warning": "!",
    "icon.info": "i",
    "icon.error": "!!",
    "icon.bell": "^",
    "icon.git-branch": "Y",
    "icon.commit": "o",
    "icon.merge": "M",
    "icon.pull-request": "PR",
    "icon.issue": "#",
    "icon.tag": "T",
    "icon.star": "*",
    "icon.heart": "<3",
    "icon.user": "@",
    "icon.folder": "/",
    "icon.file": "f",
    "icon.lock": "L",
    "icon.link": "&",
    "icon.download": "v_",
    "icon.upload": "^_",
    "icon.play": ">",
    "icon.pause": "||",
    "icon.stop": "[]",
    "icon.refresh": "~",
    "icon.search": "?",
    "icon.settings": "%",
    "icon.home": "H",
    "icon.terminal": "$",
    "icon.code": "<>",
    "icon.database": "DB",
    "icon.server": "S",
    "icon.cloud": "C",
    "icon.bug": "B",
    "icon.rocket": "^^",
    "icon.bolt": "z",
    "icon.chart": "|",
    "icon.list": "=",
    "icon.mail": "m",
    "icon.comment": "\"",
    "icon.eye": "0",
    "icon.package": "P",
    "icon.shield": "U",
    "icon.key": "k",
    "icon.cpu": "C",
    "icon.gauge": "%",
    "chart.level": ["_", "-", "=", "#"],
    "pip.filled": "*",
    "pip.empty": ".",
    "mark.facet": "#",
    "activity.busy": ["|", "/", "-", "\\"],
    "activity.idle": ".",


    "commit.head": "@",
    "commit": "o",

    "sync.behind": "v",
    "sync.ahead": "^",

    "tree.first": ".-",
    "tree.branch": "|-",
    "tree.last": "`-",
    "tree.vertical": "|",
    "tree.divider": "-",
    "tree.column-divider": "|",

    "bar.thick": "|",
    "bar.medium": "|",
    "bar.thin": "|",
    "cursor.text": "_",
    "cursor.masked": "*",
    "scroll.thumb": "#",

    "arrow.up": "^",
    "arrow.down": "v",
    "arrow.left": "<",
    "arrow.right": ">",
    "arrow.external": ">",
    "arrow.to": "->",
    "chevron.right": ">",
    "step.previous": "<",
    "step.next": ">",
    "step.decrease": "-",
    "step.increase": "+",
    "chevron.collapsed": ">",
    "chevron.expanded": "v",
    "submenu": ">",
    "dropdown": "v",
    "prompt": ">",
    "menu": "=",
    "manage": "=",
    "code": "",
    "architect": "",
    "spec": "",
    "overview": "",
    "map": "",
    "changes": "",
    "in-flight": "",
    "contract": "",
    "finished": "",
    "decision": "",

    "text.ellipsis": "...",
    "text.em-dash": "--",
    "text.separator": " | ",
    "text.plus-minus": "+-"
