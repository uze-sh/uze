{
  "hooks": {
    "PreToolUse": [
      {
        "id": "guard",
        "matcher": "shell",
        "effect": "deny",
        "hooks": [
          {
            "type": "command",
            "command": {
              "posix": "${PLUGIN_ROOT}/scripts/guard",
              "windows": "& \"${PLUGIN_ROOT}/scripts/guard.ps1\""
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
