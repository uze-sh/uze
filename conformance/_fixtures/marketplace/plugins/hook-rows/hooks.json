{
  "hooks": {
    "PreToolUse": [
      {
        "id": "census",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/probe census allow",
            "timeout": 10
          }
        ]
      },
      {
        "id": "row-shell",
        "matcher": "shell",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/probe row-shell allow",
            "timeout": 10
          }
        ]
      },
      {
        "id": "row-file-read",
        "matcher": "file.read",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/scripts/probe row-file-read allow",
            "timeout": 10
          }
        ]
      },
      {
        "id": "row-file-write",
        "matcher": "file.write",
        "effect": "observe",
        "hooks": [
          {
            "type": "command",
