{
  "events": [
    "pre_tool_use",
    "post_tool_use",
    "stop",
    "session_start"
  ],
  "effects": [
    "observe",
    "allow",
    "ask",
    "deny",
    "transform"
  ],
  "aliases": {
    "shell": {
      "tools": [
        "run_command"
      ],
      "fields": {
        "command": "CommandLine"
      },
      "call": {
        "CommandLine": "mkdir -p {dir} && printf ran > {side} # {mark}",
        "WaitMsBeforeAsync": 2000,
        "toolSummary": "Lab command"
      }
    },
    "file.read": {
      "tools": [
        "read_file"
      ],
      "fields": {
        "path": "Path"
      },
      "call": {
        "Path": "{project}/README.md"
      }
    },
    "file.write": {
      "tools": [
        "write_file"
      ],
      "fields": {
        "path": "Path"
      },
      "call": {
        "Path": "{side}",
        "Content": "lab",
        "Overwrite": true
      }
    },
    "file.edit": {
      "tools": [
        "edit_file"
      ],
      "fields": {
        "path": "Path"
      },
      "call": {
        "Path": "{project}/README.md",
        "Target": "lab project",
        "Replacement": "lab project, edited"
      }
    },
    "search.files": null,
    "search.web": {
      "tools": [
        "search_web"
      ],
      "fields": {
        "query": "query"
      },
      "call": {
        "query": "lab"
      }
    },
    "agent.spawn": {
      "tools": [
        "invoke_subagent"
      ],
      "fields": {},
      "call": {
        "TypeName": "flow_auditor",
        "Role": "Lab",
        "Prompt": "lab subagent"
      }
    },
    "agent.message": {
      "tools": [
        "send_message"
      ],
      "fields": {},
      "call": {
        "Message": "lab",
        "Recipient": "general"
      }
    }
  }
}
