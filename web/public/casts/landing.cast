[59.19486, "o", "::\u001b[38;5;148;48;5;22mtext\u001b[38;5;231;48;5;22m(\u001b[38;5;141;48;5;22m200\u001b[38;5;231;48;5;22m, \u001b[38;5;186;48;5;22m\"pong\"\u001b[38;5;231;48;5;22m.\u001b[38;5;148;48;5;22mto_string\u001b[38;5;231;48;5;22m()),                               \u001b[38;2;230;228;222;48;2;10;12;13m       \u001b[11;33H     \u001b[2m\u001b[38;5;231;48;2;10;12;13m  8 \u001b[22m         _ => \u001b[38;5;148;48;2;10;12;13mnot_found\u001b[38;5;231;48;2;10;12;13m(path),\u001b[38;2;230;228;222;48;2;10;12;13m                                                                    \u001b[12;33H     \u001b[2m\u001b[38;5;231;48;2;10;12;13m  9 \u001b[22m     }\u001b[38;2;230;228;222;48;2;10;12;13m                                                                                            \u001b[13;33H     \u001b[2m\u001b[38;5;231;48;2;10;12;13m 10 \u001b[22m }\u001b[38;2;230;228;222;48;2;10;12;13m                                                                                                \u001b[14;33H                                                                                                           \u001b[15;33H\u001b[38;5;114;48;2;10;12;13m●\u001b[38;2;230;228;222;48;2;10;12;13m \u001b[1mSkill\u001b[22m(git:commit)                                                                                        \u001b[16;33H\u001b[38;5;246;48;2;10;12;13m  ⎿  \u001b[38;2;230;228;222;48;2;10;12;13mSuccessfully loaded skill                                                                             \u001b[17;33H                                                                                                           \u001b[18;33H  \u001b[38;5;246;48;2;10;12;13mRan \u001b[1m2\u001b[22m shell commands \u001b[38;2;230;228;222;48;2;10;12;13m                                                                                    \u001b[19;33H                                                                                                           \u001b[20;33H\u001b[38;5;231;48;2;10;1