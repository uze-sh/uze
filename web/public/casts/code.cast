[22.423596, "o", "\u001b[3;62H\u001b[38;2;168;166;160;48;2;10;12;13mAGENTS.md · preview\u001b[3;135H\u001b[1m\u001b[38;2;242;240;234;48;2;32;34;35m Preview \u001b[22m\u001b[38;2;107;113;118;48;2;10;12;13m Source \u001b[5;64H\u001b[1m\u001b[38;2;242;240;234;48;2;10;12;13mAGENTS.md\u001b[7;64H\u001b[22mGuidance for agentic tools working in this repository.\u001b[9;64H\u001b[1mWhat this is\u001b[11;64H\u001b[22m\u001b[38;2;125;151;201;48;2;10;12;13mdemo-app\u001b[38;2;242;240;234;48;2;10;12;13m is a small HTTP service. \u001b[38;2;125;151;201;48;2;10;12;13msrc/router.rs\u001b[38;2;242;240;234;48;2;10;12;13m maps a path to a response; \u001b[38;2;125;151;201;48;2;10;12;13mconfig.toml\u001b[12;64H\u001b[38;2;242;240;234;48;2;10;12;13mcarries the runtime settings.\u001b[14;64H\u001b[1mConventions\u001b[16;64H\u001b[22m\u001b[38;2;107;113;118;48;2;10;12;13m• \u001b[38;2;242;240;234;48;2;10;12;13mKeep handlers total: every route returns a \u001b[38;2;125;151;201;48;2;10;12;13mResponse\u001b[38;2;242;240;234;48;2;10;12;13m, never panics.\u001b[17;64H\u001b[38;2;107;113;118;48;2;10;12;13m• \u001b[38;2;242;240;234;48;2;10;12;13mDocument a new route in \u001b[38;2;125;151;201;48;2;10;12;13mdocs/lifecycle.md\u001b[38;2;242;240;234;48;2;10;12;13m in the same change.\u001b[18;64H\u001b[38;2;107;113;118;48;2;10;12;13m• \u001b[38;2;242;240;234;48;2;10;12;13mConventional Commits for commit subjects.\u001b[19;103H\u001b[39;48;2;10;12;13m        \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
